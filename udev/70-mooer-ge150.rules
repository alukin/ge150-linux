# Mooer GE150 (VID 0483, PID 5703): user access to the HID control interface.
#
# The file name must sort before 73-seat-late.rules, otherwise TAG+="uaccess" is ignored.
# Install:  sudo cp udev/70-mooer-ge150.rules /etc/udev/rules.d/
#           sudo udevadm control --reload && sudo udevadm trigger
KERNEL=="hidraw*", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5703", TAG+="uaccess", MODE="0660"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5703", TAG+="uaccess", MODE="0660"
